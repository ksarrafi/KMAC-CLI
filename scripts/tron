#!/usr/bin/env bash
# tron — Tron control plane: Docker Isos (ephemeral runs, optional pool, blueprints, CI-parity checks).
#
# Env:
#   KMAC_TRON_IMAGE          — image tag (default kmac/tron-iso:latest)
#   KMAC_TRON_POOL_ROOT      — state dir (default ~/.cache/kmac/tron)
#   KMAC_TRON_POOL_SIZE      — default slot count for pool start (default 2)
#   KMAC_TRON_LOCK_TIMEOUT_SEC — pool slot wait (default 300)
#   KMAC_TRON_NO_LOG         — set to 1 to disable run history logging

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=scripts/_ui.sh
source "$SCRIPT_DIR/_ui.sh"

KMAC_TRON_IMAGE="${KMAC_TRON_IMAGE:-kmac/tron-iso:latest}"
DOCKERFILE="$TOOLKIT_DIR/docker/tron/Dockerfile"
POOL_ROOT="${KMAC_TRON_POOL_ROOT:-${HOME}/.cache/kmac/tron}"
LOG_DIR="$POOL_ROOT/runs"
BLUEPRINTS_DIR="$TOOLKIT_DIR/scripts/_tron/blueprints"
_TRON_LOCK_DIR=""
KMAC_TRON_LOCK_TIMEOUT_SEC="${KMAC_TRON_LOCK_TIMEOUT_SEC:-300}"

tron_cleanup_lock() {
    if [[ -n "${_TRON_LOCK_DIR:-}" ]] && [[ -d "${_TRON_LOCK_DIR:-}" ]]; then
        rmdir "$_TRON_LOCK_DIR" 2>/dev/null || true
    fi
    _TRON_LOCK_DIR=""
}

docker_ok() {
    command -v docker &>/dev/null || {
        ui_fail "docker not found in PATH"
        return 1
    }
    docker info &>/dev/null || {
        ui_fail "Docker daemon not reachable — start Docker Desktop or the docker service"
        return 1
    }
    return 0
}

cmd_build() {
    docker_ok || return 1
    if [[ ! -f "$DOCKERFILE" ]]; then
        ui_fail "missing Dockerfile: $DOCKERFILE"
        return 1
    fi
    ui_info "Building $KMAC_TRON_IMAGE ..."
    docker build -t "$KMAC_TRON_IMAGE" -f "$DOCKERFILE" "$TOOLKIT_DIR/docker/tron"
}

ensure_image() {
    docker_ok || return 1
    if docker image inspect "$KMAC_TRON_IMAGE" &>/dev/null; then
        return 0
    fi
    ui_warn "Image $KMAC_TRON_IMAGE not found — building from $DOCKERFILE"
    cmd_build
}

_tron_log_event() {
    [[ "${KMAC_TRON_NO_LOG:-}" == "1" ]] && return 0
    local event="$1"
    local detail="${2:-}"
    mkdir -p "$LOG_DIR"
    local ts
    ts=$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || date)
    printf '%s [%s] %s\n' "$ts" "$event" "$detail" >> "$LOG_DIR/history.log"
}

# mkdir-based lock (macOS-friendly)
_acquire_pool_lock() {
    local slot="$1"
    local lockdir="$POOL_ROOT/locks/slot-$slot"
    local tries=0
    local max
    max=$(( KMAC_TRON_LOCK_TIMEOUT_SEC * 10 ))
    mkdir -p "$POOL_ROOT/locks"
    while ! mkdir "$lockdir" 2>/dev/null; do
        sleep 0.1
        tries=$((tries + 1))
        if (( tries > max )); then
            ui_fail "timeout waiting for pool slot $slot (${KMAC_TRON_LOCK_TIMEOUT_SEC}s)"
            return 1
        fi
    done
    _TRON_LOCK_DIR="$lockdir"
    return 0
}

_release_pool_lock() {
    tron_cleanup_lock
}

_reset_pool_workspace_host() {
    local pws="$1"
    mkdir -p "$pws"
    find "$pws" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
}

_sync_workdir_to_pool() {
    local src="$1"
    local dst="$2"
    if command -v rsync &>/dev/null; then
        if [[ -f "$src/.tronignore" ]]; then
            rsync -a --delete --exclude-from="$src/.tronignore" "$src"/ "$dst"/
        else
            rsync -a --delete "$src"/ "$dst"/
        fi
    else
        _reset_pool_workspace_host "$dst"
        cp -a "$src"/. "$dst"/
    fi
}

cmd_pool_start() {
    local n="${1:-${KMAC_TRON_POOL_SIZE:-2}}"
    case "$n" in
        '' | *[!0-9]*) ui_fail "pool size must be a number (1–32)"; return 1 ;;
    esac
    ((n >= 1 && n <= 32)) || {
        ui_fail "pool size must be between 1 and 32"
        return 1
    }
    docker_ok || return 1
    ensure_image || return 1
    mkdir -p "$POOL_ROOT/ws"
    local i name ws
    for ((i = 1; i <= n; i++)); do
        name="kmac-tron-pool-$i"
        ws="$POOL_ROOT/ws/$i"
        mkdir -p "$ws"
        if docker inspect "$name" &>/dev/null; then
            ui_warn "container $name already exists — skip (use: tron pool stop)"
            continue
        fi
        docker run -d --name "$name" \
            --security-opt no-new-privileges \
            -v "$ws:/workspace" \
            -w /workspace \
            "$KMAC_TRON_IMAGE" \
            tail -f /dev/null
        ui_success "pool slot $i → $name (workspace $ws)"
    done
}

cmd_pool_stop() {
    docker_ok || return 1
    local ids
    ids=$(docker ps -aq --filter "name=kmac-tron-pool-" 2>/dev/null || true)
    if [[ -z "$ids" ]]; then
        ui_info "no kmac-tron-pool-* containers found"
        return 0
    fi
    # shellcheck disable=SC2086
    docker rm -f $ids
    ui_success "removed pool containers"
}

cmd_pool_status() {
    docker_ok || return 1
    echo ""
    ui_info "image: $KMAC_TRON_IMAGE"
    if docker image inspect "$KMAC_TRON_IMAGE" &>/dev/null; then
        ui_success "image present"
    else
        ui_warn "image not built — run: kmac tron build"
    fi
    echo ""
    docker ps -a --filter "name=kmac-tron-pool-" --format "table {{.Names}}\t{{.Status}}\t{{.Mounts}}" 2>/dev/null || true
    echo ""
    ui_dim "pool root: $POOL_ROOT"
    ui_dim "run logs: $LOG_DIR/history.log"
}

cmd_pool_run() {
    local slot="$1"
    local workdir="$2"
    shift 2
    local -a usercmd=("$@")
    [[ "$slot" =~ ^[0-9]+$ ]] || {
        ui_fail "pool slot must be numeric"
        return 1
    }
    local name="kmac-tron-pool-$slot"
    docker inspect "$name" &>/dev/null || {
        ui_fail "no container $name — run: kmac tron pool start"
        return 1
    }
    [[ -d "$workdir" ]] || {
        ui_fail "workdir not found: $workdir"
        return 1
    }

    docker_ok || return 1
    ensure_image || return 1

    local pws="$POOL_ROOT/ws/$slot"
    mkdir -p "$POOL_ROOT/ws"

    trap '_release_pool_lock; trap - RETURN' RETURN
    _acquire_pool_lock "$slot" || return 1

    ui_info "reset workspace for slot $slot..."
    _reset_pool_workspace_host "$pws"
    ui_info "sync $(basename "$workdir") → pool slot $slot..."
    _sync_workdir_to_pool "$workdir" "$pws"

    if [[ ${#usercmd[@]} -eq 0 ]]; then
        usercmd=(bash -l)
    fi

    local ttyflag=()
    [[ -t 0 ]] && ttyflag=(-it)

    _tron_log_event "pool-exec-start" "slot=$slot wd=$workdir cmd=${usercmd[*]}"

    docker exec "${ttyflag[@]}" \
        -e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}" \
        -e "OPENAI_API_KEY=${OPENAI_API_KEY:-}" \
        -e "TERM=${TERM:-xterm-256color}" \
        -w /workspace \
        "$name" \
        /usr/local/bin/iso-entry "${usercmd[@]}"

    local ec=$?
    _tron_log_event "pool-exec-done" "exit=$ec slot=$slot"
    ui_info "post-run reset for slot $slot..."
    docker exec "$name" bash -c 'find /workspace -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true' || true
    _release_pool_lock
    trap - RETURN
    return "$ec"
}

# Generate bash script from JSON blueprint (requires python3 on host)
_blueprint_emit_script() {
    local bpfile="$1"
    command -v python3 &>/dev/null || {
        ui_fail "python3 required on host to run blueprints"
        return 1
    }
    BLUEPRINT_JSON="$bpfile" python3 <<'PY'
import json, sys, re, os
path = os.environ["BLUEPRINT_JSON"]
with open(path, encoding="utf-8") as f:
    data = json.load(f)
lines = [
    "#!/usr/bin/env bash",
    "set -euo pipefail",
    "cd /workspace",
    'echo "══ Tron blueprint: %s ══"' % data.get("name", "unnamed"),
]
for i, st in enumerate(data.get("steps", []), 1):
    name = st.get("name", str(i))
    run = (st.get("run") or "").strip()
    if not run:
        continue
    safe = re.sub(r"['\"\\\\]", "", name[:60])
    lines.append("echo ''")
    lines.append('echo ">>> Step %d: %s"' % (i, safe))
    lines.append(run)
print("\n".join(lines))
PY
}

cmd_blueprint() {
    local workdir="$PWD"
    local bpfile=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -w | --workdir)
                workdir="${2:-}"
                [[ -n "$workdir" ]] || {
                    ui_fail "--workdir needs a path"
                    return 1
                }
                workdir="$(cd "$workdir" 2>/dev/null && pwd)" || {
                    ui_fail "cannot cd to workdir: $workdir"
                    return 1
                }
                shift 2
                ;;
            --)
                shift
                break
                ;;
            *)
                if [[ -z "$bpfile" ]]; then
                    bpfile="$1"
                    shift
                    break
                fi
                ui_fail "unexpected argument: $1"
                return 1
                ;;
        esac
    done
    [[ -n "$bpfile" ]] || {
        ui_fail "usage: kmac tron blueprint [-w DIR] <file.json>"
        return 1
    }
    if [[ "$bpfile" != /* ]]; then
        bpfile="$workdir/$bpfile"
    fi
    [[ -f "$bpfile" ]] || {
        ui_fail "blueprint not found: $bpfile"
        return 1
    }

    docker_ok || return 1
    ensure_image || return 1

    local tf
    tf=$(mktemp "${TMPDIR:-/tmp}/tron-bp.XXXXXX") || return 1
    _blueprint_emit_script "$bpfile" >"$tf" || {
        rm -f "$tf"
        return 1
    }
    chmod +x "$tf"

    local ttyflag=()
    [[ -t 0 ]] && ttyflag=(-it)

    _tron_log_event "blueprint-start" "file=$bpfile wd=$workdir"

    docker run --rm "${ttyflag[@]}" \
        --read-only \
        --tmpfs /tmp:rw,exec,size=128m \
        --security-opt no-new-privileges \
        --cap-drop ALL \
        -v "$workdir:/workspace:rw" \
        -v "$tf:/tmp/tron-blueprint.sh:ro" \
        -w /workspace \
        -e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}" \
        -e "OPENAI_API_KEY=${OPENAI_API_KEY:-}" \
        -e "TERM=${TERM:-xterm-256color}" \
        "$KMAC_TRON_IMAGE" \
        bash /tmp/tron-blueprint.sh

    local ec=$?
    rm -f "$tf"
    _tron_log_event "blueprint-done" "exit=$ec file=$bpfile"
    return "$ec"
}

cmd_check() {
    local wd="${1:-$PWD}"
    wd="$(cd "$wd" 2>/dev/null && pwd)" || {
        ui_fail "bad directory: $1"
        return 1
    }
    local bp="$BLUEPRINTS_DIR/kmac-check.json"
    [[ -f "$bp" ]] || {
        ui_fail "bundled blueprint missing: $bp"
        return 1
    }
    ui_info "Running comprehensive check (syntax + ShellCheck + tests) in Iso..."
    cmd_blueprint -w "$wd" "$bp"
}

cmd_swarm() {
    local wd="${1:-$PWD}"
    wd="$(cd "$wd" 2>/dev/null && pwd)" || {
        ui_fail "bad directory: $1"
        return 1
    }
    local bp="$BLUEPRINTS_DIR/swarm-review.json"
    [[ -f "$bp" ]] || {
        ui_fail "bundled blueprint missing: $bp"
        return 1
    }
    ui_info "Running swarm-style scan (TODO grep + size + hint) in Iso..."
    cmd_blueprint -w "$wd" "$bp"
}

cmd_demo() {
    docker_ok || return 1
    ensure_image || return 1
    local workdir
    workdir="$(pwd)"
    _tron_log_event "demo" "wd=$workdir"
    ui_info "Tron demo — ephemeral Iso, one-shot..."
    docker run --rm \
        --read-only \
        --tmpfs /tmp:rw,exec,size=64m \
        --security-opt no-new-privileges \
        --cap-drop ALL \
        -v "$workdir:/workspace:rw" \
        -w /workspace \
        "$KMAC_TRON_IMAGE" \
        bash -lc 'echo "✓ Iso OK  pwd=$(pwd)  uname=$(uname -s)"'
    local ec=$?
    _tron_log_event "demo-done" "exit=$ec"
    return "$ec"
}

cmd_runs() {
    local n="${1:-20}"
    if [[ ! -f "$LOG_DIR/history.log" ]]; then
        ui_info "no run history yet (LOG_DIR=$LOG_DIR)"
        return 0
    fi
    echo ""
    ui_info "last entries from history.log:"
    echo ""
    tail -n "$n" "$LOG_DIR/history.log"
    echo ""
}

cmd_run() {
    local workdir="$PWD"
    local pool_slot=""
    local -a docker_extra=()
    local secure_mode="0"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -w | --workdir)
                workdir="${2:-}"
                [[ -n "$workdir" ]] || {
                    ui_fail "--workdir needs a path"
                    return 1
                }
                workdir="$(cd "$workdir" 2>/dev/null && pwd)" || {
                    ui_fail "cannot cd to workdir: $workdir"
                    return 1
                }
                shift 2
                ;;
            --pool)
                pool_slot="${2:-}"
                shift 2
                ;;
            --network)
                docker_extra+=(--network "${2:-}")
                shift 2
                ;;
            --env-file)
                docker_extra+=(--env-file "${2:-}")
                shift 2
                ;;
            --secure)
                secure_mode="1"
                shift
                ;;
            --)
                shift
                break
                ;;
            *)
                break
                ;;
        esac
    done
    local -a usercmd=("$@")

    if [[ -n "$pool_slot" ]]; then
        cmd_pool_run "$pool_slot" "$workdir" "${usercmd[@]}"
        return $?
    fi

    [[ -d "$workdir" ]] || {
        ui_fail "workdir not found: $workdir"
        return 1
    }

    docker_ok || return 1
    ensure_image || return 1

    if [[ ${#usercmd[@]} -eq 0 ]]; then
        usercmd=(bash -l)
    fi

    local ttyflag=()
    [[ -t 0 ]] && ttyflag=(-it)

    if [[ "$secure_mode" == "1" ]]; then
        docker_extra+=(--read-only --tmpfs /tmp:rw,exec,size=128m --security-opt no-new-privileges --cap-drop ALL)
    fi

    _tron_log_event "run-start" "wd=$workdir secure=$secure_mode cmd=${usercmd[*]}"

    docker run --rm "${ttyflag[@]}" "${docker_extra[@]}" \
        -v "$workdir:/workspace:rw" \
        -w /workspace \
        -e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}" \
        -e "OPENAI_API_KEY=${OPENAI_API_KEY:-}" \
        -e "TERM=${TERM:-xterm-256color}" \
        "$KMAC_TRON_IMAGE" \
        "${usercmd[@]}"

    local ec=$?
    _tron_log_event "run-done" "exit=$ec"
    return "$ec"
}

print_help() {
    title_box "Tron — Isos (Docker)" "◆"
    echo -e "  ${DIM}Ephemeral runs (default), warm pool, JSON blueprints, CI-parity check.${NC}"
    echo ""
    echo -e "  ${BOLD}Core${NC}"
    echo "    kmac tron build              Build Iso image ($KMAC_TRON_IMAGE)"
    echo "    kmac tron run [-w DIR] [--secure] [--env-file F] [--network NAME] [--] cmd..."
    echo "    kmac tron iso ...            Alias for run"
    echo ""
    echo -e "  ${BOLD}Blueprints${NC} ${DIM}(JSON: name, steps[].name, steps[].run)${NC}"
    echo "    kmac tron blueprint [-w DIR] path/to.json"
    echo "    kmac tron check [DIR]       Bundled kmac-check: bash -n + ShellCheck + tests"
    echo "    kmac tron swarm [DIR]       Bundled swarm-review (scan + sizes + hint)"
    echo "    kmac tron demo              Quick sanity check in Iso"
    echo ""
    echo -e "  ${BOLD}Pool${NC}"
    echo "    kmac tron pool start [N]     Warm N slots"
    echo "    kmac tron pool status"
    echo "    kmac tron pool stop"
    echo "    kmac tron run --pool SLOT -w DIR [--] cmd"
    echo ""
    echo -e "  ${BOLD}History${NC}"
    echo "    kmac tron runs [N]           Tail last N lines of run log"
    echo ""
    echo -e "  ${DIM}Pool sync respects .tronignore in the source dir (rsync exclude).${NC}"
    echo -e "  ${BOLD}--secure${NC} ${DIM}adds read-only root, tmpfs /tmp, no-new-privileges, cap-drop ALL.${NC}"
    echo ""
    echo -e "  ${BOLD}Bundled blueprints:${NC} $BLUEPRINTS_DIR"
    echo ""
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        help | -h | --help)
            print_help
            ;;
        build | image)
            cmd_build
            ;;
        run)
            cmd_run "$@"
            ;;
        iso | exec)
            cmd_run "$@"
            ;;
        blueprint | bp)
            cmd_blueprint "$@"
            ;;
        check)
            cmd_check "$@"
            ;;
        swarm)
            cmd_swarm "$@"
            ;;
        demo)
            cmd_demo
            ;;
        runs | log | logs)
            cmd_runs "${1:-20}"
            ;;
        pool)
            local sub="${1:-status}"
            shift || true
            case "$sub" in
                start | up) cmd_pool_start "${1:-}" ;;
                stop | down) cmd_pool_stop ;;
                status | st) cmd_pool_status ;;
                *)
                    ui_fail "unknown pool subcommand: $sub (start|stop|status)"
                    return 1
                    ;;
            esac
            ;;
        version)
            echo "tron 2.0.0 (KMac-CLI)"
            ;;
        *)
            ui_fail "unknown command: $cmd — try: kmac tron help"
            return 1
            ;;
    esac
}

main "$@"
