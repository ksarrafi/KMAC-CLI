#!/bin/bash
# vault — vault manager (action menu + optional full browse)
# Usage: vault              (interactive action menu)
#        vault list         (show all keys)
#        vault get <key>    (get a key value)
#        vault set <key>    (set a key value)
#        vault delete <key> (delete a key)
#        vault project      (project-specific key manager)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_ui.sh"
source "$SCRIPT_DIR/_vault.sh"

# ─── Browse all vault keys (not just integrations) ───────────────────────────

do_browse() {
    title_box "Vault Key Browser" "🔐"
    
    local backend
    backend=$(_vault_backend)
    echo -e "  ${BOLD}Backend:${NC} ${CYAN}${backend}${NC}"
    
    if [[ "$backend" == "docker" ]]; then
        if _docker_vault_running 2>/dev/null; then
            echo -e "  ${GREEN}●${NC} ${DIM}Docker vault running on 127.0.0.1:${VAULT_DOCKER_PORT}${NC}"
        else
            echo -e "  ${YELLOW}○${NC} ${DIM}Docker vault not running${NC}"
        fi
    fi
    echo ""
    
    # Get all keys (not just integrations), exclude metadata keys
    echo -e "  ${DIM}Loading keys...${NC}"
    local -a all_keys=()
    while IFS= read -r key; do
        [[ -n "$key" && ! "$key" =~ ^__meta__: ]] && all_keys+=("$key")
    done < <(vault_list 2>/dev/null)
    
    # Clear loading message
    echo -ne "\r\033[K"
    
    if (( ${#all_keys[@]} == 0 )); then
        echo -e "  ${YELLOW}No keys stored yet${NC}"
        echo ""
        echo -e "  ${DIM}Get started:${NC}"
        echo -e "    • Press ${GREEN}a${NC} to add your first key using the wizard"
        echo -e "    • Or run: ${CYAN}kmac vault set${NC}"
        echo ""
        echo -e "  ${DIM}Common first keys to add:${NC}"
        echo -e "    • OpenAI API key for AI integrations"
        echo -e "    • Anthropic (Claude) API key"
        echo -e "    • Database credentials for your projects"
        echo ""
        return
    fi
    
    # Organize by namespace (prefix before ':')
    # Bash 3.2 compatible - no associative arrays
    local -a namespaces=()
    local -a ungrouped=()
    
    # First pass: collect unique namespaces
    for key in "${all_keys[@]}"; do
        if [[ "$key" =~ ^([^:]+):(.+)$ ]]; then
            local ns="${BASH_REMATCH[1]}"
            if [[ ! " ${namespaces[*]} " =~ " ${ns} " ]]; then
                namespaces+=("$ns")
            fi
        else
            ungrouped+=("$key")
        fi
    done
    
    # Display grouped by namespace
    for ns in "${namespaces[@]}"; do
        echo -e "  ${BOLD}${CYAN}${ns}/${NC}"
        echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"
        
        # Second pass: show keys for this namespace
        for key in "${all_keys[@]}"; do
            if [[ "$key" =~ ^${ns}:(.+)$ ]]; then
                local key_name="${BASH_REMATCH[1]}"  # Save key name before it gets overwritten
                local val
                val=$(vault_get "$key" 2>/dev/null)
                local masked="••••••••"
                if [[ -n "$val" && ${#val} -gt 8 ]]; then
                    masked="${val:0:4}••••${val: -4}"
                fi
                
                # Get metadata if available
                local meta_date=""
                local meta_key="__meta__:${key}"
                if vault_has "$meta_key" 2>/dev/null; then
                    local meta
                    meta=$(vault_get "$meta_key" 2>/dev/null)
                    if [[ "$meta" =~ created=([^|]+) ]]; then
                        meta_date="${BASH_REMATCH[1]}"
                    fi
                fi
                
                # Display with or without timestamp
                if [[ -n "$meta_date" ]]; then
                    printf "  ${GREEN}  ├─${NC} %-30s ${DIM}%s  [%s]${NC}\n" "$key_name" "$masked" "$meta_date"
                else
                    printf "  ${GREEN}  ├─${NC} %-30s ${DIM}%s${NC}\n" "$key_name" "$masked"
                fi
            fi
        done
        echo ""
    done
    
    # Display ungrouped keys
    if (( ${#ungrouped[@]} > 0 )); then
        echo -e "  ${BOLD}${YELLOW}Other Keys${NC}"
        echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"
        for key in "${ungrouped[@]}"; do
            local val
            val=$(vault_get "$key" 2>/dev/null)
            local masked="••••••••"
            if [[ -n "$val" && ${#val} -gt 8 ]]; then
                masked="${val:0:4}••••${val: -4}"
            fi
            printf "  ${GREEN}  ├─${NC} %-40s ${DIM}%s${NC}\n" "$key" "$masked"
        done
        echo ""
    fi
    
    echo -e "  ${BOLD}Total:${NC} ${#all_keys[@]} keys"
    echo ""
}

# Compact home screen — summary + actions (not a wall of every key).
do_dashboard() {
    title_box "Vault Manager" "🔐"

    local backend
    backend=$(_vault_backend)
    echo -e "  ${BOLD}Backend:${NC} ${CYAN}${backend}${NC}"

    if [[ "$backend" == "docker" ]]; then
        if _docker_vault_running 2>/dev/null; then
            echo -e "  ${GREEN}●${NC} ${DIM}Running on 127.0.0.1:${VAULT_DOCKER_PORT}${NC}"
        else
            echo -e "  ${YELLOW}○${NC} ${DIM}Docker vault not running${NC}"
        fi
    fi
    echo ""

    local -a all_keys=()
    while IFS= read -r key; do
        [[ -n "$key" && ! "$key" =~ ^__meta__: ]] && all_keys+=("$key")
    done < <(vault_list 2>/dev/null)

    if (( ${#all_keys[@]} == 0 )); then
        echo -e "  ${YELLOW}No keys stored yet${NC}"
        echo ""
        echo -e "  ${DIM}Press ${GREEN}a${DIM} to add your first key, or ${GREEN}p${DIM} to set up a project.${NC}"
        echo ""
        return
    fi

    _vault_collect_projects
    local -a projects=("${VAULT_PICK_PROJECTS[@]}")
    local proj_count=${#projects[@]}
    local ungrouped=0
    for key in "${all_keys[@]}"; do
        [[ ! "$key" =~ : ]] && ((ungrouped++))
    done

    if (( proj_count > 0 )); then
        echo -e "  ${BOLD}${#all_keys[@]} keys${NC} across ${BOLD}${proj_count}${NC} project(s)"
    else
        echo -e "  ${BOLD}${#all_keys[@]} keys${NC} ${DIM}(no project namespaces)${NC}"
    fi
    (( ungrouped > 0 )) && echo -e "  ${DIM}${ungrouped} ungrouped key(s)${NC}"
    echo ""

    if (( proj_count > 0 )); then
        echo -e "  ${BOLD}Projects${NC} ${DIM}(press ${GREEN}p${DIM} to manage)${NC}"
        echo -e "  ${DIM}$(printf '─%.0s' {1..40})${NC}"
        local max_show=8
        local i shown=0
        for i in "${!projects[@]}"; do
            (( shown >= max_show )) && break
            local count
            count=$(_vault_project_key_count "${projects[$i]}")
            printf "    ${CYAN}%-22s${NC} ${DIM}%d keys${NC}\n" "${projects[$i]}" "$count"
            ((shown++))
        done
        if (( proj_count > max_show )); then
            echo -e "    ${DIM}... and $((proj_count - max_show)) more${NC}"
        fi
        echo ""
    fi

    echo -e "  ${DIM}Full key listing: press ${GREEN}l${DIM}  ·  Search: ${GREEN}/${DIM}${NC}"
    echo ""
}

# ─── Common key types for wizard ─────────────────────────────────────────────

_get_common_key_types() {
    cat << 'EOF'
OpenAI API Key
Anthropic (Claude) API Key
Google AI (Gemini) Key
Groq API Key
Stripe Secret Key
Stripe Publishable Key
Database URL
Database Password
JWT Secret
API Key (Generic)
OAuth Client ID
OAuth Client Secret
Webhook URL
SendGrid API Key
Twilio Auth Token
AWS Access Key
AWS Secret Key
GitHub Token
GitLab Token
Docker Hub Token
Redis URL
MongoDB URL
PostgreSQL URL
Other (Custom)
EOF
}

# ─── Shared pickers (list selection, not free-text guessing) ─────────────────

_vault_mask_value() {
    local val="$1"
    if [[ -n "$val" && ${#val} -gt 8 ]]; then
        echo "${val:0:4}••••${val: -4}"
    else
        echo "••••••••"
    fi
}

_vault_collect_projects() {
    local -a _out=()
    while IFS= read -r key; do
        [[ -n "$key" && ! "$key" =~ ^__meta__: ]] || continue
        if [[ "$key" =~ ^([^:]+): ]]; then
            local proj="${BASH_REMATCH[1]}"
            if [[ ! " ${_out[*]} " =~ " ${proj} " ]]; then
                _out+=("$proj")
            fi
        fi
    done < <(vault_list 2>/dev/null)
    if (( ${#_out[@]} > 0 )); then
        local _sorted
        _sorted=$(printf '%s\n' "${_out[@]}" | sort -f)
        _out=()
        while IFS= read -r _p; do
            [[ -n "$_p" ]] && _out+=("$_p")
        done <<< "$_sorted"
    fi
    VAULT_PICK_PROJECTS=("${_out[@]}")
}

_vault_project_key_count() {
    local proj="$1"
    local count=0
    while IFS= read -r key; do
        [[ "$key" =~ ^${proj}: ]] && ((count++))
    done < <(vault_list 2>/dev/null)
    echo "$count"
}

_vault_ungrouped_key_count() {
    local count=0
    while IFS= read -r key; do
        [[ -n "$key" && ! "$key" =~ ^__meta__: && ! "$key" =~ : ]] && ((count++))
    done < <(vault_list 2>/dev/null)
    echo "$count"
}

# Sets VAULT_PICK_RESULT to project name, or empty on cancel.
# allow_new: true = offer "create new project"; false = existing projects only.
_vault_pick_project() {
    local allow_new="${1:-true}"
    VAULT_PICK_RESULT=""

    _vault_collect_projects
    local -a projects=("${VAULT_PICK_PROJECTS[@]}")
    local ungrouped_count
    ungrouped_count=$(_vault_ungrouped_key_count)

    while true; do
        clear
        title_box "Select Project" "📦"
        echo ""

        local max_choice=0

        if (( ${#projects[@]} > 0 )); then
            echo -e "  ${BOLD}Your projects:${NC}"
            echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"
            local i
            for i in "${!projects[@]}"; do
                local count
                count=$(_vault_project_key_count "${projects[$i]}")
                printf "  %2d) ${CYAN}%-24s${NC} ${DIM}(%d keys)${NC}\n" "$((i+1))" "${projects[$i]}" "$count"
            done
            max_choice=${#projects[@]}
            echo ""
        else
            echo -e "  ${DIM}No project namespaces yet.${NC}"
            echo ""
        fi

        if (( ungrouped_count > 0 )); then
            max_choice=$((max_choice + 1))
            printf "  %2d) ${YELLOW}Other keys${NC}             ${DIM}(%d ungrouped)${NC}\n" "$max_choice" "$ungrouped_count"
            echo ""
        fi

        if [[ "$allow_new" == true ]]; then
            echo -e "  ${GREEN}0)${NC}  ${BOLD}+ Create new project${NC}"
            echo ""
        fi

        if (( max_choice == 0 && allow_new != true )); then
            echo -e "  ${DIM}No keys in any project.${NC}"
            sleep 1.5
            return
        fi

        echo -e "  ${DIM}Enter the number to select. 'c' = cancel.${NC}"
        echo ""
        read -r -p "  > " choice

        [[ "$choice" == [cC] ]] && return

        if [[ "$allow_new" == true && "$choice" == "0" ]]; then
            echo ""
            read -r -p "  New project name ('c' to cancel) > " project
            [[ "$project" == [cC] || -z "$project" ]] && return
            if [[ ! "$project" =~ ^[a-zA-Z0-9_-]+$ ]]; then
                echo ""
                echo -e "  ${RED}✗ Use only letters, numbers, hyphens, and underscores${NC}"
                sleep 1.5
                continue
            fi
            VAULT_PICK_RESULT="$project"
            return
        fi

        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#projects[@]} )); then
            VAULT_PICK_RESULT="${projects[$((choice-1))]}"
            return
        fi

        if (( ungrouped_count > 0 )) && [[ "$choice" =~ ^[0-9]+$ ]] && (( choice == max_choice )); then
            VAULT_PICK_RESULT="__ungrouped__"
            return
        fi

        echo ""
        echo -e "  ${RED}✗ Pick a number from the list${NC}"
        sleep 1
    done
}

# Sets VAULT_PICK_RESULT to full key (project:key), or empty on cancel.
# filter_project: project name, "__ungrouped__", or empty for all keys.
_vault_pick_key() {
    local filter_project="${1:-}"
    local title="${2:-Select Key}"
    VAULT_PICK_RESULT=""

    local -a keys=()
    while IFS= read -r key; do
        [[ -n "$key" && ! "$key" =~ ^__meta__: ]] || continue
        if [[ "$filter_project" == "__ungrouped__" ]]; then
            [[ "$key" =~ : ]] && continue
        elif [[ -n "$filter_project" ]]; then
            [[ "$key" =~ ^${filter_project}: ]] || continue
        fi
        keys+=("$key")
    done < <(vault_list 2>/dev/null)

    if (( ${#keys[@]} == 0 )); then
        echo -e "  ${DIM}No keys to select.${NC}"
        return 1
    fi

    local scope_label=""
    if [[ "$filter_project" == "__ungrouped__" ]]; then
        scope_label="Other keys"
    elif [[ -n "$filter_project" ]]; then
        scope_label="$filter_project"
    fi

    while true; do
        clear
        if [[ -n "$scope_label" ]]; then
            title_box "$title — $scope_label" "🔑"
        else
            title_box "$title" "🔑"
        fi
        echo ""
        echo -e "  ${BOLD}Pick a key:${NC}"
        echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"

        local i
        for i in "${!keys[@]}"; do
            local val masked label="${keys[$i]}"
            val=$(vault_get "${keys[$i]}" 2>/dev/null)
            masked=$(_vault_mask_value "$val")
            if [[ -n "$filter_project" && "$filter_project" != "__ungrouped__" && "$label" =~ ^${filter_project}:(.+)$ ]]; then
                label="${BASH_REMATCH[1]}"
            fi
            printf "  %2d) ${CYAN}%-36s${NC} ${DIM}%s${NC}\n" "$((i+1))" "$label" "$masked"
        done

        echo ""
        echo -e "  ${DIM}Enter the number to select. 'c' = cancel.${NC}"
        echo ""
        read -r -p "  > " choice

        [[ "$choice" == [cC] ]] && return 1

        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#keys[@]} )); then
            VAULT_PICK_RESULT="${keys[$((choice-1))]}"
            return 0
        fi

        echo ""
        echo -e "  ${RED}✗ Pick a number from the list${NC}"
        sleep 1
    done
}

# Step 1: pick project. Step 2: pick key within that project.
_vault_pick_key_via_project() {
    local title="${1:-Select Key}"
    VAULT_PICK_RESULT=""

    _vault_pick_project false || return 1
    local project="$VAULT_PICK_RESULT"
    [[ -z "$project" ]] && return 1

    _vault_pick_key "$project" "$title" || return 1
    return 0
}

# Update an existing key — pick from list, enter new value only.
do_update_key() {
    local preset_key="$1"

    local full_key="$preset_key"
    if [[ -z "$full_key" ]]; then
        _vault_pick_key_via_project "Update Key" || return
        full_key="$VAULT_PICK_RESULT"
    fi

    [[ -z "$full_key" ]] && return

    if ! vault_has "$full_key" 2>/dev/null; then
        echo -e "  ${RED}✗ Key not found:${NC} ${full_key}"
        return 1
    fi

    local existing_value key_type=""
    existing_value=$(vault_get "$full_key" 2>/dev/null)

    local meta_key="__meta__:${full_key}"
    if vault_has "$meta_key" 2>/dev/null; then
        local meta
        meta=$(vault_get "$meta_key" 2>/dev/null)
        [[ "$meta" =~ type=([^|]+) ]] && key_type="${BASH_REMATCH[1]}"
    fi

    clear
    title_box "Update Key" "🔐"
    echo ""
    echo -e "  ${BOLD}Key:${NC} ${CYAN}${full_key}${NC}"
    [[ -n "$key_type" ]] && echo -e "  ${BOLD}Type:${NC} ${key_type}"
    echo -e "  ${BOLD}Current:${NC} $(_vault_mask_value "$existing_value")"
    echo ""
    echo -e "  ${DIM}Enter the new value below (leave blank to keep current).${NC}"
    echo ""

    local value=""
    read -r -s -p "  New value (hidden, Enter = keep, 'c' = cancel) > " value
    echo ""

    if [[ "$value" == [cC] ]]; then
        echo -e "  ${DIM}Cancelled.${NC}"
        return
    fi

    if [[ -z "$value" ]]; then
        echo -e "  ${DIM}No change — value kept.${NC}"
        return
    fi

    if vault_set "$full_key" "$value"; then
        local timestamp
        timestamp=$(date "+%Y-%m-%d %H:%M:%S")
        if vault_has "$meta_key" 2>/dev/null; then
            local old_meta
            old_meta=$(vault_get "$meta_key" 2>/dev/null)
            if [[ "$old_meta" =~ type=([^|]+) ]]; then
                vault_set "$meta_key" "type=${BASH_REMATCH[1]}|created=$timestamp" 2>/dev/null
            else
                vault_set "$meta_key" "created=$timestamp" 2>/dev/null
            fi
        else
            vault_set "$meta_key" "created=$timestamp" 2>/dev/null
        fi
        echo ""
        echo -e "  ${GREEN}✓ Updated: ${BOLD}${full_key}${NC}"
        echo -e "  ${DIM}Timestamp: ${timestamp}${NC}"
    else
        echo -e "  ${RED}✗ Failed to save${NC}"
    fi
}

# ─── Wizard: Add Key (new keys only; use do_update_key to change values) ─────

do_set_key_wizard() {
    local preset_project="$1"
    
    # Step 1: Project name (with retry loop)
    local project=""
    
    if [[ -n "$preset_project" ]]; then
        project="$preset_project"
    else
        _vault_pick_project true || return
        project="$VAULT_PICK_RESULT"
        [[ -z "$project" ]] && return
    fi
    
    # Step 2: Key type/purpose OR update existing key in this project
    local key_type=""
    local key_name=""
    
    while true; do
        clear
        title_box "Add Vault Key" "🔐"
        echo ""
        echo -e "  ${BOLD}Project:${NC} ${CYAN}${project}${NC}"
        echo ""

        # Existing keys in this project — offer update shortcut
        local -a proj_existing=()
        while IFS= read -r key; do
            [[ "$key" =~ ^${project}: ]] && proj_existing+=("$key")
        done < <(vault_list 2>/dev/null)

        local type_offset=0
        if (( ${#proj_existing[@]} > 0 )); then
            echo -e "  ${BOLD}Existing keys${NC} ${DIM}(pick one to update its value)${NC}"
            echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"
            local i
            for i in "${!proj_existing[@]}"; do
                local val masked name
                val=$(vault_get "${proj_existing[$i]}" 2>/dev/null)
                masked=$(_vault_mask_value "$val")
                name="${proj_existing[$i]#*:}"
                printf "  %2d) ${YELLOW}↻${NC} %-28s ${DIM}%s${NC}\n" "$((i+1))" "$name" "$masked"
            done
            type_offset=${#proj_existing[@]}
            echo ""
        fi

        echo -e "  ${BOLD}Add a new key${NC}"
        echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"
        
        local -a key_types
        key_types=()
        while IFS= read -r ktype; do
            [[ -n "$ktype" ]] && key_types+=("$ktype")
        done < <(_get_common_key_types)
        
        # Show in two columns
        local mid=$(( (${#key_types[@]} + 1) / 2 ))
        local i
        for i in $(seq 0 $((mid - 1))); do
            local left=$((i + type_offset + 1))
            local right=$((i + mid + type_offset + 1))
            printf "    %2d) %-30s" "$left" "${key_types[$i]}"
            if (( i + mid < ${#key_types[@]} )); then
                printf "%2d) %s" "$right" "${key_types[$((i + mid))]}"
            fi
            echo ""
        done
        
        local max_choice=$((type_offset + ${#key_types[@]}))
        echo ""
        read -r -p "  Choose [1-${max_choice}] or 'c' to cancel > " type_choice
        
        # Handle cancel
        if [[ "$type_choice" == [cC] ]]; then
            echo -e "  ${DIM}Cancelled.${NC}"
            return
        fi
        
        # Validate input
        if [[ ! "$type_choice" =~ ^[0-9]+$ ]]; then
            echo ""
            echo -e "  ${RED}✗ Please enter a number from the list${NC}"
            sleep 1
            continue
        fi
        
        if (( type_choice < 1 || type_choice > max_choice )); then
            echo ""
            echo -e "  ${RED}✗ Invalid choice. Please choose 1-${max_choice}${NC}"
            sleep 1
            continue
        fi

        # Update existing key in this project
        if (( type_choice <= type_offset )); then
            do_update_key "${proj_existing[$((type_choice - 1))]}"
            return
        fi
        
        key_type="${key_types[$((type_choice - type_offset - 1))]}"
        
        # Convert to key name
        case "$key_type" in
            "OpenAI API Key") key_name="openai_key" ;;
            "Anthropic (Claude) API Key") key_name="anthropic_key" ;;
            "Google AI (Gemini) Key") key_name="google_ai_key" ;;
            "Groq API Key") key_name="groq_key" ;;
            "Stripe Secret Key") key_name="stripe_secret" ;;
            "Stripe Publishable Key") key_name="stripe_publishable" ;;
            "Database URL") key_name="database_url" ;;
            "Database Password") key_name="db_password" ;;
            "JWT Secret") key_name="jwt_secret" ;;
            "API Key (Generic)") key_name="api_key" ;;
            "OAuth Client ID") key_name="oauth_client_id" ;;
            "OAuth Client Secret") key_name="oauth_client_secret" ;;
            "Webhook URL") key_name="webhook_url" ;;
            "SendGrid API Key") key_name="sendgrid_key" ;;
            "Twilio Auth Token") key_name="twilio_token" ;;
            "AWS Access Key") key_name="aws_access_key" ;;
            "AWS Secret Key") key_name="aws_secret_key" ;;
            "GitHub Token") key_name="github_token" ;;
            "GitLab Token") key_name="gitlab_token" ;;
            "Docker Hub Token") key_name="docker_token" ;;
            "Redis URL") key_name="redis_url" ;;
            "MongoDB URL") key_name="mongodb_url" ;;
            "PostgreSQL URL") key_name="postgresql_url" ;;
            "Other (Custom)")
                # Retry loop for custom key name
                while true; do
                    echo ""
                    read -r -p "  Key name ('c' to cancel) > " key_name
                    
                    if [[ "$key_name" == [cC] ]]; then
                        key_name=""
                        break
                    fi
                    
                    if [[ -z "$key_name" ]]; then
                        echo ""
                        echo -e "  ${RED}✗ Key name cannot be empty${NC}"
                        sleep 1
                        continue
                    fi
                    
                    # Normalize to lowercase with underscores
                    key_name=$(echo "$key_name" | tr '[:upper:]' '[:lower:]' | tr ' ' '_' | tr -cd 'a-z0-9_')
                    
                    if [[ -z "$key_name" ]]; then
                        echo ""
                        echo -e "  ${RED}✗ Invalid key name (use letters, numbers, underscores)${NC}"
                        sleep 1
                        continue
                    fi
                    
                    break
                done
                ;;
        esac
        
        # Check if cancelled from custom key name input
        if [[ -z "$key_name" ]]; then
            echo -e "  ${DIM}Cancelled.${NC}"
            return
        fi
        
        # Valid key type and name - break loop
        break
    done
    
    local full_key="${project}:${key_name}"
    
    # Check if key exists and show history
    local is_update=false
    if vault_has "$full_key" 2>/dev/null; then
        is_update=true
        local existing_value
        existing_value=$(vault_get "$full_key" 2>/dev/null)
        
        clear
        title_box "Update Existing Key" "🔐"
        echo ""
        echo -e "  ${YELLOW}This key already exists!${NC}"
        echo ""
        echo -e "  ${BOLD}Key:${NC} ${CYAN}${full_key}${NC}"
        echo -e "  ${BOLD}Type:${NC} ${key_type}"
        echo -e "  ${BOLD}Current Value:${NC} ${existing_value:0:4}••••${existing_value: -4}"
        
        # Try to get metadata
        local meta_key="__meta__:${full_key}"
        if vault_has "$meta_key" 2>/dev/null; then
            local meta
            meta=$(vault_get "$meta_key" 2>/dev/null)
            if [[ -n "$meta" ]]; then
                echo -e "  ${BOLD}Last Updated:${NC} ${DIM}${meta}${NC}"
            fi
        fi
        
        echo ""
        echo -e "  ${YELLOW}Do you want to update this key?${NC}"
        read -r -n1 -p "  (y/N): " confirm; echo ""
        [[ "$confirm" != [yY] ]] && { echo -e "  ${DIM}Cancelled.${NC}"; return; }
    fi
    
    # Step 3: Enter value (with retry loop)
    local value=""
    
    while true; do
        clear
        title_box "Add/Update Vault Key" "🔐"
        echo ""
        echo -e "  ${BOLD}Project:${NC} ${CYAN}${project}${NC}"
        echo -e "  ${BOLD}Type:${NC} ${key_type}"
        echo -e "  ${BOLD}Key:${NC} ${full_key}"
        echo ""
        echo -e "  ${BOLD}Step 3 of 3: Enter the value${NC}"
        echo -e "  ${DIM}──────────────────────────────────────${NC}"
        echo ""
        
        # Show format hints for known types
        case "$key_type" in
            "OpenAI API Key")
                echo -e "  ${DIM}Format: sk-proj-... or sk-...${NC}"
                ;;
            "Anthropic (Claude) API Key")
                echo -e "  ${DIM}Format: sk-ant-...${NC}"
                ;;
            "GitHub Token")
                echo -e "  ${DIM}Format: ghp_... or github_pat_...${NC}"
                ;;
        esac
        
        read -r -s -p "  Value (hidden, Ctrl+C to cancel) > " value
        echo ""
        
        # Validate not empty
        if [[ -z "$value" ]]; then
            echo ""
            echo -e "  ${RED}✗ Value cannot be empty${NC}"
            sleep 1
            continue
        fi
        
        # Basic format validation for known types
        local validation_warning=""
        case "$key_type" in
            "OpenAI API Key")
                [[ ! "$value" =~ ^sk- ]] && validation_warning="OpenAI keys usually start with 'sk-'"
                ;;
            "Anthropic (Claude) API Key")
                [[ ! "$value" =~ ^sk-ant- ]] && validation_warning="Anthropic keys usually start with 'sk-ant-'"
                ;;
            "GitHub Token")
                [[ ! "$value" =~ ^(ghp_|github_pat_) ]] && validation_warning="GitHub tokens usually start with 'ghp_' or 'github_pat_'"
                ;;
        esac
        
        if [[ -n "$validation_warning" ]]; then
            echo ""
            echo -e "  ${YELLOW}⚠ Warning: ${validation_warning}${NC}"
            echo ""
            read -r -n1 -p "  Continue anyway? (y/N/r to retry) > " cont; echo ""
            
            if [[ "$cont" == [rR] ]]; then
                value=""
                continue
            elif [[ "$cont" != [yY] ]]; then
                echo -e "  ${DIM}Cancelled.${NC}"
                return
            fi
        fi
        
        # Valid value - break loop
        break
    done
    
    # Save the key
    if vault_set "$full_key" "$value"; then
        # Save metadata
        local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
        local metadata="type=$key_type|created=$timestamp"
        vault_set "__meta__:${full_key}" "$metadata" 2>/dev/null
        
        echo ""
        if [[ "$is_update" == true ]]; then
            echo -e "  ${GREEN}✓ Updated: ${BOLD}${full_key}${NC}"
        else
            echo -e "  ${GREEN}✓ Created: ${BOLD}${full_key}${NC}"
        fi
        echo -e "  ${DIM}Timestamp: ${timestamp}${NC}"
    else
        echo -e "  ${RED}✗ Failed to save${NC}"
    fi
}

# ─── Legacy set (for CLI use) ────────────────────────────────────────────────

do_set_key() {
    local key="$1"
    
    # If no key provided, use wizard
    if [[ -z "$key" ]]; then
        do_set_key_wizard
        return
    fi
    
    # Direct set (for scripts/CLI)
    if vault_has "$key" 2>/dev/null; then
        local cur
        cur=$(vault_get "$key" 2>/dev/null)
        echo ""
        echo -e "  ${DIM}Current: ${cur:0:4}••••${NC}"
    fi
    
    echo ""
    read -r -s -p "  Value (hidden): " value
    echo ""
    
    if [[ -z "$value" ]]; then
        echo -e "  ${DIM}Cancelled.${NC}"
        return
    fi
    
    if vault_set "$key" "$value"; then
        # Save metadata
        local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
        vault_set "__meta__:${key}" "created=$timestamp" 2>/dev/null
        echo -e "  ${GREEN}✓ Saved: ${BOLD}${key}${NC}"
    else
        echo -e "  ${RED}✗ Failed to save${NC}"
    fi
}

# ─── Get a key value ─────────────────────────────────────────────────────────

do_get_key() {
    local key="$1"
    
    if [[ -z "$key" ]]; then
        _vault_pick_key_via_project "Get Key Value" || return
        key="$VAULT_PICK_RESULT"
    fi
    
    [[ -z "$key" ]] && return
    
    echo ""
    echo -e "  ${DIM}Retrieving...${NC}"
    local val
    val=$(vault_get "$key" 2>/dev/null)
    echo -ne "\r\033[K"
    
    if [[ -n "$val" ]]; then
        echo -e "  ${GREEN}✓${NC} ${BOLD}${key}${NC}"
        echo ""
        echo "$val"
    else
        echo -e "  ${RED}✗ Key not found:${NC} ${key}"
        return 1
    fi
}

# ─── Delete a key ────────────────────────────────────────────────────────────

do_delete_key() {
    local key="$1"
    
    if [[ -z "$key" ]]; then
        _vault_pick_key_via_project "Delete Key" || return
        key="$VAULT_PICK_RESULT"
    fi
    
    [[ -z "$key" ]] && return
    
    # Show key details before deletion
    clear
    title_box "Delete Vault Key" "🗑️"
    echo ""
    
    # Check if key exists
    if ! vault_has "$key" 2>/dev/null; then
        echo -e "  ${RED}✗ Key not found:${NC} ${key}"
        echo ""
        read -r -n1 -p "  Press any key to continue..."; echo ""
        return
    fi
    
    # Get key value (masked)
    local value
    value=$(vault_get "$key" 2>/dev/null)
    
    echo -e "  ${YELLOW}⚠ You are about to delete:${NC}"
    echo ""
    echo -e "  ${BOLD}Key:${NC} ${CYAN}${key}${NC}"
    if [[ -n "$value" ]]; then
        echo -e "  ${BOLD}Value:${NC} ${value:0:4}••••${value: -4}"
    fi
    
    # Try to show metadata
    local meta_key="__meta__:${key}"
    if vault_has "$meta_key" 2>/dev/null; then
        local meta
        meta=$(vault_get "$meta_key" 2>/dev/null)
        if [[ -n "$meta" ]]; then
            echo -e "  ${BOLD}Created:${NC} ${DIM}${meta}${NC}"
        fi
    fi
    
    echo ""
    echo -e "  ${RED}${BOLD}This action cannot be undone!${NC}"
    echo ""
    read -r -p "  Type 'DELETE' to confirm, or anything else to cancel > " confirm
    
    if [[ "$confirm" == "DELETE" ]]; then
        vault_del "$key" 2>/dev/null
        # Also delete metadata
        vault_del "$meta_key" 2>/dev/null
        echo ""
        echo -e "  ${GREEN}✓ Deleted: ${key}${NC}"
        sleep 1
    else
        echo ""
        echo -e "  ${DIM}Cancelled. Key was not deleted.${NC}"
        sleep 1
    fi
}

# ─── Project-specific key manager ────────────────────────────────────────────

do_project_keys() {
    local project="$1"
    
    if [[ -z "$project" ]]; then
        _vault_pick_project true || return
        project="$VAULT_PICK_RESULT"
    fi
    
    [[ -z "$project" ]] && return
    
    while true; do
        clear
        title_box "Project: $project" "📦"
        
        # Get all keys for this project
        local -a proj_keys=()
        while IFS= read -r key; do
            [[ "$key" =~ ^${project}: ]] && proj_keys+=("$key")
        done < <(vault_list 2>/dev/null)
        
        if (( ${#proj_keys[@]} > 0 )); then
            echo -e "  ${BOLD}Keys:${NC}"
            echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"
            for key in "${proj_keys[@]}"; do
                local val
                val=$(vault_get "$key" 2>/dev/null)
                local masked="••••••••"
                if [[ -n "$val" && ${#val} -gt 8 ]]; then
                    masked="${val:0:4}••••${val: -4}"
                fi
                local name="${key#*:}"
                printf "  ${GREEN}✓${NC} %-30s ${DIM}%s${NC}\n" "$name" "$masked"
            done
        else
            echo -e "  ${DIM}No keys yet for this project.${NC}"
        fi
        
        echo ""
        echo -e "  ${BOLD}Actions:${NC}"
        echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"
        echo -e "  ${CYAN}Manage Keys${NC}"
        echo -e "    ${GREEN}a${NC})  Add key ${DIM}(wizard)${NC}"
        echo -e "    ${GREEN}e${NC})  Edit key"
        echo -e "    ${GREEN}d${NC})  Delete key ${DIM}(with preview)${NC}"
        echo ""
        echo -e "  ${CYAN}Import/Export${NC}"
        echo -e "    ${GREEN}x${NC})  Export to .env file"
        echo -e "    ${GREEN}i${NC})  Import from .env file"
        echo -e "    ${GREEN}c${NC})  Copy all to clipboard"
        echo ""
        echo -e "  ${GREEN}h${NC})  Help  ${GREEN}q${NC})  Back to vault browser"
        echo ""
        read -r -n1 -p "  > " action; echo ""
        
        case "$action" in
            a|A)
                # Pre-fill project in wizard
                do_set_key_wizard "$project"
                ;;
            e|E)
                if (( ${#proj_keys[@]} == 0 )); then
                    echo -e "  ${DIM}No keys to edit.${NC}"
                else
                    _vault_pick_key "$project" "Update Key" && do_update_key "$VAULT_PICK_RESULT"
                fi
                ;;
            d|D)
                if (( ${#proj_keys[@]} == 0 )); then
                    echo ""
                    echo -e "  ${DIM}No keys to delete.${NC}"
                    sleep 1
                else
                    _vault_pick_key "$project" "Delete Key" && do_delete_key "$VAULT_PICK_RESULT"
                fi
                ;;
            x|X)
                _export_project_env "$project" "${proj_keys[@]}"
                ;;
            i|I)
                _import_project_env "$project"
                ;;
            c|C)
                _copy_project_env "$project" "${proj_keys[@]}"
                ;;
            h|H)
                clear
                title_box "Project Manager Help" "❓"
                echo ""
                echo -e "  ${BOLD}Current Project:${NC} ${CYAN}${project}${NC}"
                echo ""
                echo -e "  ${BOLD}Actions:${NC}"
                echo -e "    ${GREEN}a${NC}) Add key      - Launch wizard to add new key"
                echo -e "    ${GREEN}e${NC}) Edit key     - Update an existing key value"
                echo -e "    ${GREEN}d${NC}) Delete key   - Remove key with preview"
                echo ""
                echo -e "  ${BOLD}Import/Export:${NC}"
                echo -e "    ${GREEN}x${NC}) Export       - Save all keys to .env file"
                echo -e "    ${GREEN}i${NC}) Import       - Load keys from .env file"
                echo -e "    ${GREEN}c${NC}) Copy         - Copy all to clipboard"
                echo ""
                echo -e "  ${BOLD}Tips:${NC}"
                echo -e "    • .env files are great for local dev"
                echo -e "    • Share .env with AI tools temporarily"
                echo -e "    • Always delete .env after use"
                echo -e "    • Keys are stored securely in vault"
                echo ""
                read -r -n1 -p "  Press any key to continue..."; echo ""
                ;;
            q|Q|"")
                return
                ;;
        esac
        
        echo ""
        [[ "$action" != [qQ] ]] && { read -r -n1 -p "  Press any key..."; echo ""; }
    done
}

# ─── Export project keys to .env file ────────────────────────────────────────

_export_project_env() {
    local project="$1"
    shift
    local -a keys=("$@")
    
    if (( ${#keys[@]} == 0 )); then
        echo -e "  ${DIM}No keys to export.${NC}"
        return
    fi
    
    echo ""
    local default_file="${project}.env"
    read -r -p "  Save to file [${default_file}]: " envfile
    envfile="${envfile:-$default_file}"
    
    # Resolve to absolute path
    [[ "$envfile" != /* ]] && envfile="$PWD/$envfile"
    
    echo ""
    echo -e "  ${DIM}Exporting ${#keys[@]} keys to ${envfile}...${NC}"
    
    {
        echo "# Environment variables for: $project"
        echo "# Generated: $(date)"
        echo ""
        for key in "${keys[@]}"; do
            local val
            val=$(vault_get "$key" 2>/dev/null)
            if [[ -n "$val" ]]; then
                # Convert project:key to KEY format
                local envname="${key#*:}"
                envname=$(echo "$envname" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
                echo "${envname}=${val}"
            fi
        done
    } > "$envfile"
    
    chmod 600 "$envfile"
    echo -e "  ${GREEN}✓ Exported to: ${envfile}${NC}"
}

# ─── Import from .env file ───────────────────────────────────────────────────

_import_project_env() {
    local project="$1"
    
    echo ""
    read -r -p "  Path to .env file: " envfile
    [[ -z "$envfile" ]] && return
    
    # Expand ~ and resolve path
    envfile="${envfile/#\~/$HOME}"
    [[ "$envfile" != /* ]] && envfile="$PWD/$envfile"
    
    if [[ ! -f "$envfile" ]]; then
        echo -e "  ${RED}File not found: ${envfile}${NC}"
        return
    fi
    
    local count=0
    local total_lines=$(grep -c "^[^#]" "$envfile" 2>/dev/null || echo "0")
    
    echo ""
    echo -e "  ${CYAN}⏳ Importing from ${envfile}...${NC}"
    echo ""
    
    while IFS='=' read -r key val; do
        # Skip comments and empty lines
        [[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
        
        # Convert KEY_NAME to key-name format
        local vaultkey=$(echo "$key" | tr '[:upper:]' '[:lower:]' | tr '_' '-')
        vaultkey="${project}:${vaultkey}"
        
        if vault_set "$vaultkey" "$val"; then
            echo -e "  ${GREEN}✓${NC} $key → $vaultkey"
            ((count++))
        else
            echo -e "  ${RED}✗${NC} $key (failed)"
        fi
    done < "$envfile"
    
    echo ""
    echo -e "  ${GREEN}✓ Imported ${count} keys${NC}"
}

# ─── Copy project env to clipboard ──────────────────────────────────────────

_copy_project_env() {
    local project="$1"
    shift
    local -a keys=("$@")
    
    if (( ${#keys[@]} == 0 )); then
        echo -e "  ${DIM}No keys to copy.${NC}"
        return
    fi
    
    local envtext=""
    for key in "${keys[@]}"; do
        local val
        val=$(vault_get "$key" 2>/dev/null)
        if [[ -n "$val" ]]; then
            local envname="${key#*:}"
            envname=$(echo "$envname" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
            envtext+="${envname}=${val}"$'\n'
        fi
    done
    
    if command -v pbcopy &>/dev/null; then
        echo -n "$envtext" | pbcopy
        echo -e "  ${GREEN}✓ Copied ${#keys[@]} keys to clipboard${NC}"
    else
        echo -e "  ${YELLOW}Clipboard not available (pbcopy not found)${NC}"
        echo ""
        echo "$envtext"
    fi
}

# ─── Interactive Menu ─────────────────────────────────────────────────────────

do_menu() {
    while true; do
        clear
        do_dashboard
        
        echo -e "  ${BOLD}What do you want to do?${NC}"
        echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"
        echo -e "  ${CYAN}Quick Actions${NC}"
        echo -e "    ${GREEN}a${NC})  Add new key ${DIM}(pick project + type)${NC}"
        echo -e "    ${GREEN}u${NC})  Update key ${DIM}(project → key)${NC}"
        echo -e "    ${GREEN}g${NC})  Get key value ${DIM}(project → key)${NC}"
        echo -e "    ${GREEN}d${NC})  Delete key ${DIM}(project → key)${NC}"
        echo ""
        echo -e "  ${CYAN}Projects${NC}"
        echo -e "    ${GREEN}p${NC})  Open project manager ${DIM}(pick project)${NC}"
        echo ""
        echo -e "  ${GREEN}l${NC})  List all keys  ${GREEN}/${NC})  Search  ${GREEN}h${NC})  Help  ${GREEN}q${NC})  Back"
        echo ""
        read -r -n1 -p "  > " action; echo ""
        
        case "$action" in
            a|A) do_set_key_wizard ;;
            u|U) do_update_key ;;
            d|D) do_delete_key ;;
            g|G) 
                echo ""
                do_get_key
                ;;
            p|P) do_project_keys ;;
            l|L)
                clear
                do_browse
                echo ""
                read -r -n1 -p "  Press any key..."; echo ""
                ;;
            r|R) continue ;;
            /)
                echo ""
                read -r -p "  Search for ('c' to cancel) > " search_term
                [[ "$search_term" == [cC] || -z "$search_term" ]] && continue
                
                clear
                title_box "Search Results: $search_term" "🔍"
                echo ""
                
                local -a matches=()
                while IFS= read -r key; do
                    [[ -n "$key" && ! "$key" =~ ^__meta__: ]] && {
                        if [[ "$key" =~ $search_term ]]; then
                            matches+=("$key")
                        fi
                    }
                done < <(vault_list 2>/dev/null)
                
                if (( ${#matches[@]} == 0 )); then
                    echo -e "  ${YELLOW}No keys matching '${search_term}'${NC}"
                else
                    echo -e "  ${GREEN}Found ${#matches[@]} key(s):${NC}"
                    echo -e "  ${DIM}$(printf '─%.0s' {1..60})${NC}"
                    for key in "${matches[@]}"; do
                        local val
                        val=$(vault_get "$key" 2>/dev/null)
                        local masked="••••••••"
                        if [[ -n "$val" && ${#val} -gt 8 ]]; then
                            masked="${val:0:4}••••${val: -4}"
                        fi
                        printf "  ${CYAN}%-40s${NC} ${DIM}%s${NC}\n" "$key" "$masked"
                    done
                fi
                echo ""
                read -r -n1 -p "  Press any key to continue..."; echo ""
                ;;
            h|H)
                clear
                title_box "Vault Manager Help" "❓"
                echo ""
                echo -e "  ${BOLD}Quick Start:${NC}"
                echo -e "    • Press ${GREEN}a${NC} to add a new key (pick project + type from lists)"
                echo -e "    • Press ${GREEN}u${NC} to update (pick project, then key)"
                echo -e "    • Press ${GREEN}p${NC} to manage keys by project"
                echo -e "    • Press ${GREEN}g${NC} to get a key value (pick project, then key)"
                echo ""
                echo -e "  ${BOLD}Key Format:${NC}"
                echo -e "    project:keyname  ${DIM}(e.g., myapp:api_key)${NC}"
                echo ""
                echo -e "  ${BOLD}CLI Commands:${NC}"
                echo -e "    kmac vault list              ${DIM}# Browse all keys${NC}"
                echo -e "    kmac vault set               ${DIM}# Launch wizard${NC}"
                echo -e "    kmac vault get myapp:key     ${DIM}# Get value${NC}"
                echo -e "    kmac vault project myapp     ${DIM}# Project manager${NC}"
                echo ""
                echo -e "  ${BOLD}Keyboard Shortcuts:${NC}"
                echo -e "    ${GREEN}l${NC}  List all keys (full browse)"
                echo -e "    ${GREEN}/${NC}  Search/filter keys"
                echo -e "    ${GREEN}h${NC}  Show this help"
                echo -e "    ${GREEN}q${NC}  Go back / Exit"
                echo ""
                echo -e "  ${BOLD}Documentation:${NC}"
                echo -e "    Full guide: ${CYAN}docs/VAULT_GUIDE.md${NC}"
                echo ""
                read -r -n1 -p "  Press any key to continue..."; echo ""
                ;;
            q|Q|"") return ;;
        esac
        
        echo ""
        [[ "$action" != [qQrR] ]] && { read -r -n1 -p "  Press any key..."; echo ""; }
    done
}

# ─── CLI Entry Point ─────────────────────────────────────────────────────────

case "${1:-}" in
    -h|--help|help)
        cat << 'HELP'
Usage: kmac vault [command] [options]

Commands:
  list              Browse all keys organized by project
  set [key]         Add a new key (wizard if no key given)
  update [key]      Update an existing key (pick from list if no key given)
  get <key>         Print key value to stdout
  delete <key>      Delete a key
  project [name]    Interactive project key manager

Examples:
  kmac vault list
  kmac vault set                        # Launch wizard
  kmac vault set myapp:api_key          # Direct set
  kmac vault get myapp:api_key          # Get value
  kmac vault project myapp              # Manage myapp keys
  
  # Export for AI tools
  kmac vault project myapp
  # Press 'x' to export to myapp.env

Key Format:
  project:keyname                       # Project-specific
  Examples: myapp:openai_key, staging:db_password

Options:
  -h, --help        Show this help

Documentation:
  Full Guide: docs/VAULT_GUIDE.md (includes quick start & examples)
  README:     See section 6 for overview
HELP
        exit 0
        ;;
    list|ls|browse)     
        do_browse
        ;;
    get)                
        do_get_key "$2"
        ;;
    set|add)
        # Use wizard if no key provided, direct set if key is given
        if [[ -z "$2" ]]; then
            do_set_key_wizard
        else
            do_set_key "$2"
        fi
        ;;
    delete|del|rm)      
        do_delete_key "$2"
        ;;
    update|edit)        
        do_update_key "$2"
        ;;
    project|proj)       
        do_project_keys "$2"
        ;;
    *)                  
        do_menu
        ;;
esac
